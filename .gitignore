# Paquetes compilados
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]

# Secretos. Nunca deben entrar al repo.
# La config y el estado reales viven en C:\ProgramData\TickFence, pero
# por si alguien copia uno acá por error:
config.json
config.json.bak*
state.json
state.json.bak*
*.key
*.pem
.env

# Editores y sistema
.vscode/
.idea/
Thumbs.db
desktop.ini

# Skills de agentes: contenido de terceros, 1.2 MB que no aporta al proyecto.
# La skill se sigue usando local; solo deja de subirse a GitHub.
# Ojo: .agents/skills/*/AGENTS.md entra en conflicto con el AGENTS.md de la
# raiz, asi que conviene que no quede trackeado.
.agents/
skills-lock.json
